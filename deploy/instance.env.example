# Copy to /srv/carmen/<instance>.env (chmod 600) and fill in. Never commit the real files.
# Generate secrets with: openssl rand -hex 32

# Host port the instance listens on (127.0.0.1 only): crm 8081, demo 8082
HTTP_PORT=8081
# Sub-path the app is served under: / for crm.carmen-crm.net, /demo/ for www.carmen-crm.net/demo
BASE_PATH=/
# Frontend image matching BASE_PATH: ghcr.io/larsmw/carmen-web (/) or ghcr.io/larsmw/carmen-web-demo (/demo/)
WEB_IMAGE=ghcr.io/larsmw/carmen-web

APP_SECRET=
DB_PASSWORD=
JWT_PASSPHRASE=

# Public URL of this instance (used in password reset links), no trailing slash
FRONTEND_URL=https://crm.carmen-crm.net
CORS_ALLOW_ORIGIN=^https://crm\.carmen-crm\.net$

# Outgoing mail. null://null disables sending.
MAILER_DSN=null://null
MAILER_FROM=noreply@carmen-crm.net

# Public demo only: the shared login shown on the login page, protected from changes
# and recreated by demo-reset.sh every night. Leave empty for a normal instance.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
