# Production image: built SPA served by nginx, /api passed to the PHP-FPM container
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Sub-path the app is served under: / (crm) or /demo/ (public demo).
# The only build-time difference between instances; everything else is runtime config.
ARG VITE_BASE=/
ENV VITE_BASE=$VITE_BASE
RUN npm run build

FROM nginx:1.29-alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
